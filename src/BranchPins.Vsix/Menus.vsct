      <Button guid="guidBranchPinsCommandSet" id="CopyCurrentPinsToBranch" priority="0x0107" type="Button"><Parent guid="guidBranchPinsCommandSet" id="BranchPinsGroup" /><Strings><ButtonText>Copy Current Pins to Branch</ButtonText></Strings></Button>
      <Button guid="guidBranchPinsCommandSet" id="CleanUpMissingBranches" priority="0x0108" type="Button"><Parent guid="guidBranchPinsCommandSet" id="BranchPinsGroup" /><Strings><ButtonText>Clean Up Missing Branches</ButtonText></Strings></Button>
      <Button guid="guidBranchPinsCommandSet" id="OpenActivityLog" priority="0x0109" type="Button"><Parent guid="guidBranchPinsCommandSet" id="BranchPinsGroup" /><Strings><ButtonText>Open Activity Log</ButtonText></Strings></Button>
    </Buttons>
