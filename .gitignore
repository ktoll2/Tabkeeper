# Repository-wide. Each platform directory (visualstudio/, vscode/) has its own .gitignore for
# build output and tooling specific to that platform.

# OS cruft
.DS_Store
Thumbs.db
ehthumbs.db

# Editors
.idea/
*.swp
*.swo
*~

# Visual Studio cache/options directory (created here if the .slnx is opened from the repo root
# instead of visualstudio/, which has its own .gitignore entry for this)
.vs/

# Local env/secrets
.env
.env.local
