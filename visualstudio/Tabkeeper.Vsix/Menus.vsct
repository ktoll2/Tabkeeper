    <Buttons>
      <Button guid="guidTabkeeperCommandSet" id="EnableTabkeeper" priority="0x0100" type="Button">
        <Parent guid="guidTabkeeperCommandSet" id="TabkeeperGroup" />
        <Strings><ButtonText>Enable Tabkeeper</ButtonText></Strings>
      </Button>
      <Button guid="guidTabkeeperCommandSet" id="SynchronizeNow" priority="0x0101" type="Button">
        <Parent guid="guidTabkeeperCommandSet" id="TabkeeperGroup" />
        <Strings><ButtonText>Sync Tabkeeper Now</ButtonText></Strings>
      </Button>
      <Button guid="guidTabkeeperCommandSet" id="ClearCurrentTabkeeper" priority="0x0102" type="Button">
        <Parent guid="guidTabkeeperCommandSet" id="TabkeeperGroup" />
        <Strings><ButtonText>Clear This Branch's Tab Set</ButtonText></Strings>
      </Button>
      <Button guid="guidTabkeeperCommandSet" id="OpenSavedPinState" priority="0x0103" type="Button">
        <Parent guid="guidTabkeeperCommandSet" id="TabkeeperGroup" />
