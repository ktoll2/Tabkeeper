      <Button guid="guidTabkeeperCommandSet" id="ImportIntoCurrentPinSet" priority="0x0106" type="Button"><Parent guid="guidTabkeeperCommandSet" id="TabkeeperGroup" /><Strings><ButtonText>Import Tab Set to This Branch</ButtonText></Strings></Button>
      <Button guid="guidTabkeeperCommandSet" id="CopyCurrentPinsToBranch" priority="0x0107" type="Button"><Parent guid="guidTabkeeperCommandSet" id="TabkeeperGroup" /><Strings><ButtonText>Copy Tab Set to Branch</ButtonText></Strings></Button>
      <Button guid="guidTabkeeperCommandSet" id="CleanUpMissingBranches" priority="0x0108" type="Button"><Parent guid="guidTabkeeperCommandSet" id="TabkeeperGroup" /><Strings><ButtonText>Clean Up Missing Branches</ButtonText></Strings></Button>
      <Button guid="guidTabkeeperCommandSet" id="OpenActivityLog" priority="0x0109" type="Button"><Parent guid="guidTabkeeperCommandSet" id="TabkeeperGroup" /><Strings><ButtonText>Open Activity Log</ButtonText></Strings></Button>
    </Buttons>
  </Commands>
