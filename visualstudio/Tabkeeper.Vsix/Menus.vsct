      <Button guid="guidTabkeeperCommandSet" id="ManageBranchRules" priority="0x0104" type="Button"><Parent guid="guidTabkeeperCommandSet" id="TabkeeperGroup" /><Strings><ButtonText>Manage Branch Rules</ButtonText></Strings></Button>
